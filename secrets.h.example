#pragma once

// Copy this file to secrets.h and fill in the values. secrets.h is git-ignored.
//
//   Copy-Item secrets.h.example secrets.h
//   notepad secrets.h

#define WIFI_SSID "your-wifi-ssid"
#define WIFI_PASSWORD "your-wifi-password"

// CircuitDigest Cloud SMS API key. Format: cd_xxxxxxxxxxxxxxxxxxxx
// Found at circuitdigest.cloud -> Account -> API Key.
#define CD_API_KEY "paste-your-circuitdigest-api-key-here"

// Numeric SMS template ID from circuitdigest.cloud -> SMS -> Templates.
//   101/105 "Your {#var#} is currently at {#var#}."
//   108      "The {#var#} is currently {#var#}. Please ensure safety."
// The firmware fills var1 with "LPG gas level" and var2 with DANGER/WARNING,
// so 108 is the intended match. See buildSmsPayload() in GLD.ino.
#define CD_TEMPLATE_ID "108"

// Recipient as country code + number, no +, spaces or dashes: 91XXXXXXXXXX.
// MUST be a number already linked to your CircuitDigest Cloud account via OTP
// verification - the API silently refuses to send to any other number.
#define CD_MOBILE "919876543210"
